  "cards": [
    {
      "dot": "cyan",
      "title": "分层规则",
      "items": [
        "依赖只许从上往下，同层禁互依",
        "循环依赖即缺陷；门禁白名单固化边界",
        "唯一豁免：L3 ensemble → probabilistic"
      ]
    },
    {
      "dot": "emerald",
      "title": "canonical 主链",
      "items": [
        "schema-2 YAML → run_canonical_config()",
        "七策略 recursive … dirrecmo",
        "变换链：归一化 → 分解 → 缩放，逆序恢复"
      ]
    },
    {
      "dot": "amber",
      "title": "关键边界与省略",
      "items": [
        "845 配置全 schema-2，无 legacy 层",
        "仅 point + 边际 quantile，无 CQR",
        "省略边与完整 DAG 见分层门禁白名单"
      ]
    }
  ]
